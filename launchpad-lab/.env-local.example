# Copy to .env-local. Placeholders only; never commit real credentials.
# Local SDK calls use az login. App Service uses its system-assigned identity.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-FOUNDRY-NAME.services.ai.azure.com/api/projects/launchpad
FOUNDRY_AGENT_NAME=mmaug-launchpad-tutor
AZURE_OPENAI_ENDPOINT=https://YOUR-FOUNDRY-NAME.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=demo-model
AZURE_OPENAI_API_VERSION=2024-10-21
# Replace with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_DEMO_API_TOKEN=REPLACE-WITH-A-RANDOM-DEMO-TOKEN
# Optional service-principal authentication instead of az login; leave blank otherwise.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional key-based Azure OpenAI authentication. Terraform disables local keys.
# Leave blank for the managed-identity/az-login path used by this workshop.
AZURE_OPENAI_API_KEY=
