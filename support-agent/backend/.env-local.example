# Copy to .env-local. Placeholders only; never commit real credentials.
# --- Storage ---------------------------------------------------------------
# Leave both blank to store tickets/knowledge in backend/.data (offline mode).
# Azure: the storage account blob endpoint; access uses az login / managed identity.
STORAGE_ACCOUNT_URL=
# Optional alternative, e.g. the Azurite emulator: UseDevelopmentStorage=true
AZURE_STORAGE_CONNECTION_STRING=
TICKETS_CONTAINER=tickets
KNOWLEDGE_CONTAINER=knowledge
# --- Specialist console ----------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SPECIALIST_API_TOKEN=REPLACE-WITH-A-RANDOM-SPECIALIST-TOKEN
# --- Optional AI drafting: off | model | agent ------------------------------
AI_MODE=off
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-FOUNDRY-NAME.services.ai.azure.com/api/projects/launchpad
FOUNDRY_AGENT_NAME=mmaug-support-agent
AZURE_OPENAI_ENDPOINT=https://YOUR-FOUNDRY-NAME.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=demo-model
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional key-based Azure OpenAI authentication (Terraform disables local keys).
AZURE_OPENAI_API_KEY=
