subscription_id     = "00000000-0000-0000-0000-000000000000"
prefix              = "mmaugyourname26"
location            = "westeurope"
ssh_public_key_path = "~/.ssh/mmaug-demo.pub"
vm_size             = "Standard_B2s"
app_service_sku     = "B1"
image_tag           = "bootstrap"

# Optional paid AI extension. Verify model availability and quota before enabling.
enable_foundry        = false
foundry_location      = "eastus2"
model_name            = "gpt-4.1-mini"
model_version         = "2025-04-14"
model_deployment_name = "demo-model"
model_sku             = "GlobalStandard"
model_capacity        = 10
foundry_agent_name    = "mmaug-launchpad-tutor"
# Use an absolute path if the active python3 does not have the demo SDKs.
agent_python_executable = "python3"
